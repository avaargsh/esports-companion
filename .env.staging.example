APP_ENV=staging
COMPOSE_PROJECT_NAME=esports-companion-staging
RUNTIME_ENV_FILE=../../.env.staging
RUNTIME_SECRETS_DIR=../secrets-staging

SERVICE_NAME=esports-companion-api
COMMIT_SHA=replace-with-release-sha
LOG_LEVEL=INFO
EXPOSE_API_DOCS=false
CORS_ALLOWED_ORIGINS=https://admin-staging.example.com
READINESS_REQUIRE_REDIS=true

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=1.0
OTEL_EXPORT_TIMEOUT_SECONDS=5

AUTH_PROVIDER=wechat
PAYMENT_PROVIDER=wechat
REFUND_PROVIDER=wechat

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
FINISH_CONFIRM_TIMEOUT_SECONDS=1800
ASSIGNMENT_START_TIMEOUT_SECONDS=600
ORDER_TIMEOUT_SCAN_SECONDS=30
ORDER_TIMEOUT_BATCH_SIZE=50
REFUND_RECONCILE_SCAN_SECONDS=60
REFUND_RECONCILE_MIN_AGE_SECONDS=30
REFUND_RECONCILE_BATCH_SIZE=20
OPERATIONAL_METRICS_SCAN_SECONDS=15

WECHAT_APP_ID=wx-replace-me
WECHAT_MCH_ID=replace-me
WECHAT_MCH_CERT_SERIAL=replace-me
WECHAT_NOTIFY_URL=https://api-staging.example.com/api/v1/payments/wechat/callback
WECHAT_REFUND_NOTIFY_URL=https://api-staging.example.com/api/v1/refunds/wechat/callback
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_TIMEOUT_SECONDS=8
WECHAT_PAY_PLATFORM_CERT_SERIAL=replace-me

INGRESS_BIND_ADDRESS=127.0.0.1
INGRESS_PORT=8081
UVICORN_WORKERS=1
